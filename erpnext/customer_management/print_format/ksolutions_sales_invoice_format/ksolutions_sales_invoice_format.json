 "format_data": "{\"header\":\"\",\"sections\":[{\"label\":\"\",\"columns\":[{\"label\":\"\",\"fields\":[{\"label\":\"Custom HTML\",\"fieldname\":\"custom_html\",\"fieldtype\":\"HTML\",\"html\":\"\\n    <div style=\\\"width: 100%; margin: 0 auto; padding: 20px; box-sizing: border-box;\\\">\\n        <div style=\\\"text-align: right;\\\">\\n            <p>{{ frappe.utils.formatdate(doc.posting_date, \\\"MMMM dd, yyyy\\\") }}</p>\\n        </div>\\n        <div style=\\\"margin-bottom: 20px;\\\">\\n            <h2 style=\\\"margin: 0; font-size: 16px; font-weight: bold;\\\">CLIENT NAME:</h2>\\n            <p>{{ doc.customer }}</p>\\n            <p>{{ doc.address_display }}</p>\\n        </div>\\n        <div style=\\\"margin-bottom: 20px;\\\">\\n            <h2 style=\\\"margin: 0; font-size: 16px; font-weight: bold; text-align: center;\\\"><u>INVOICE N\u00ba {{ doc.name }}</u></h2>\\n        </div>\\n        <table style=\\\"width: 100%; border-collapse: collapse; margin-bottom: 1px;\\\">\\n            <thead>\\n                <tr>\\n                    <th style=\\\"border: 1px solid #000; padding: 10px; text-align: left; color: #fff; font-weight: bold; background-color: #8b0000;\\\">Description</th>\\n                    <th style=\\\"border: 1px solid #000; padding: 10px; text-align: left; color: #fff; font-weight: bold; background-color: #8b0000;\\\">Amount</th>\\n                </tr>\\n            </thead>\\n            <tbody>\\n                <tr>\\n                    <td style=\\\"border: 1px solid #000; padding: 10px; text-align: left;\\\">{{ doc.job_description }}</td>\\n                    <td style=\\\"border: 1px solid #000; padding: 10px; text-align: left;\\\">{{ doc.get_formatted(\\\"total\\\") }}</td>\\n                </tr>\\n                <tr>\\n                    <td style=\\\"border: 1px solid #000; padding: 10px; text-align: left;\\\">VAT (18%)</td>\\n                    <td style=\\\"border: 1px solid #000; padding: 10px; text-align: left;\\\">{{ doc.get_formatted(\\\"total_taxes_and_charges\\\") }}</td>\\n                </tr>\\n                <tr>\\n                    <td style=\\\"border: 1px solid #000; padding: 10px; text-align: left;\\\"><strong>TOTAL</strong></td>\\n                    <td style=\\\"border: 1px solid #000; padding: 10px; text-align: left;\\\"><strong>{{ doc.get_formatted(\\\"grand_total\\\") }}</strong></td>\\n                </tr>\\n                <tr>\\n                    <td colspan=2 style=\\\"border: 1px solid #000; padding: 10px; text-align: left;\\\">\\n                        <p style=\\\"font-size:12px; text-align:center; margin-bottom: 20px;\\\"><strong style=\\\"font-size: 14px;\\\">{{ doc.get_formatted(\\\"grand_total\\\") }}</strong> to be paid on the <strong style=\\\"font-size: 14px;\\\">K-SOLUTIONS & PARTNERS</strong> account number <strong style=\\\"font-size: 14px;\\\">{{ doc.payment_account_number }}</strong></p>\\n                        <p style=\\\"font-size:12px; text-align:center; margin-top:20px; margin: 5px 0\\\">In Guaranty Trust Bank Rwanda</p>\\n                        <p style=\\\"font-size:12px; text-align:center; margin-top:20px; margin: 5px 0\\\">(Former FINA BANK Rwanda)</p>\\n                        <p style=\\\"font-size:12px; text-align:center; margin-top:20px; margin: 5px 0\\\"><a href=\\\"http://www.gtbank.co.rw/\\\">http://www.gtbank.co.rw/</a></p>\\n                        <p style=\\\"font-size:12px; text-align:center; margin-top:20px; margin: 5px 0\\\">Boulevard de la R\u00e9volution, n\u00ba 20</p>\\n                        <p style=\\\"font-size:12px; text-align:center; margin-top:20px; margin: 5px 0\\\">B.P. 331 Kigali-Rwanda</p>\\n                        <p style=\\\"font-size:12px; text-align:center; margin-top:20px; margin: 5px 0\\\">SWIFT: <strong>GTBIRWRK</strong></p>\\n                    </td>\\n                </tr>\\n             </tbody>\\n        </table>\\n        <div style=\\\"margin-left: 300px;padding: 10px 10p