 "html": "<html lang=\"en\">\r\n\r\n    <head>\r\n        <meta charset=\"UTF-8\">\r\n        <meta\r\n            name=\"viewport\"\r\n            content=\"width=device-width, initial-scale=1.0\"\r\n        >\r\n        <title>Invoice</title>\r\n        <style>\r\n            body {\r\n                font-family: \"Times New Roman\", Times, serif;\r\n                line-height: 1.6;\r\n                margin: 0;\r\n                padding: 0;\r\n            }\r\n\r\n            .container {\r\n                width: 100%;\r\n                margin: 0 auto;\r\n                padding: 20px;\r\n                box-sizing: border-box;\r\n            }\r\n\r\n            .header {\r\n                text-align: right;\r\n            }\r\n\r\n            .header span {\r\n                font-size: 14px;\r\n            }\r\n\r\n            .client-details,\r\n            .invoice-details {\r\n                margin-bottom: 20px;\r\n            }\r\n\r\n            .client-details h2,\r\n            .invoice-details h2 {\r\n                margin: 0;\r\n                font-size: 16px;\r\n                font-weight: bold;\r\n            }\r\n            \r\n            .invoice-details h2 {\r\n                text-align: center;\r\n            }\r\n\r\n            .description {\r\n                margin: 20px 0;\r\n                padding: 10px;\r\n                background-color: #f7f7f7;\r\n            }\r\n\r\n            .description h3 {\r\n                margin: 0;\r\n            }\r\n\r\n            table {\r\n                width: 100%;\r\n                border-collapse: collapse;\r\n                margin-bottom: 1px;\r\n            }\r\n\r\n            th,\r\n            td {\r\n                border: 1px solid #000;\r\n                padding: 10px;\r\n                text-align: left;\r\n            }\r\n\r\n            th {\r\n                color: #fff !important;\r\n                font-weight: bold !important;\r\n                background-color: #8b0000;\r\n            }\r\n\r\n            .totals {\r\n                font-size: 12px;\r\n                text-align: center;\r\n                margin-bottom: 20px;\r\n            }\r\n\r\n            .footer {\r\n                margin-top: 20px;\r\n                font-size: 12px;\r\n                text-align: center;\r\n            }\r\n\r\n            .footer p {\r\n                margin: 5px 0;\r\n            }\r\n            \r\n            .signature{\r\n                margin-left: 300px;\r\n                padding: 10px 10px 50px 10px;\r\n                font-weight: bold;\r\n                text-align: center;\r\n                border: 1px solid;\r\n            }\r\n            .payment-account, .grand-total{\r\n                font-size: 14px;\r\n            }\r\n        </style>\r\n    </head>\r\n\r\n    <body>\r\n        <div style=\"margin: 10px;\">\r\n            <!-- Logo Section -->\r\n            <div style=\"display: flex; justify-content: space-between; align-items: center;\">\r\n                <div>\r\n                    <img alt=\"KS&amp;P Logo\" src=\"http://157.173.115.227/files/Screenshot%202024-12-16%20100900.png\" style=\"height: 70px;\">\r\n                </div>\r\n            </div>\r\n        \r\n            <!-- Content Section -->\r\n            <div style=\"display: flex; justify-content: space-between; font-size: 14px;\">\r\n                <div>Your Legal Partner in Rwanda</div>\r\n                <div>Tin / VAT 101513695</div>\r\n            </div>\r\n            <!-- Divider -->\r\n            <hr style=\"border: none; border-top: 3px solid #8b0000; margin-top: 10px; margin-bottom: 10px;\">\r\n        </div>\r\n        <div class=\"container\">\r\n            <div class=\"header\">\r\n                <p>{{ frappe.utils.formatdate(doc.posting_date, \"MMMM dd, yyyy\") }}</p>\r\n            </div>\r\n            <div class=\"client-details\">\r\n                <h2>CLIENT NAME:</h2>\r\n                <p>{{ doc.customer }}</p>\r\n                <p>{{ doc.address_display }}</p>\r\n            </div>\r\n            <div class=\"invoice-details\">\r\n                <h2><u>INVOICE N\u00ba {{ doc.name }}</u></h2>\r\n            </div>\r\n            <table>\r\n                <thead>\r\n                    <tr>\r\n                        <th>Description</th>\r\n                        <th>Amount</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    <tr>\r\n                        <td>{{ doc.job_description }}</td>\r\n                        <td>{{ doc.get_formatted(\"total\") }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td>VAT (18%)</td>\r\n                        <td>{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td><strong>TOTAL</strong></td>\r\n                        <td><strong>{{ doc.get_formatted(\"grand_total\") }}</strong></td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td colspan=2>\r\n                            <p class=\"totals\"><strong class=\"grand-total\">{{ doc.get_formatted(\"grand_total\") }}</strong> to be paid on the <strong class=\"grand-total\">K-SOLUTIONS & PARTNERS</strong> account number <strong class=\"payment-account\">{{ doc.payment_account_number }}</strong></p>\r\n                            <p class=\"footer\">In Guaranty Trust Bank Rwanda</p>\r\n                            <p class=\"footer\">(Former FINA BANK Rwanda)</p>\r\n                            <p class=\"footer\"><a href=\"http://www.gtbank.co.rw/\">http://www.gtbank.co.rw/</a></p>\r\n                            <p class=\"footer\">Boulevard de la R\u00e9volution, n\u00ba 20</p>\r\n                            <p class=\"footer\">B.P. 331 Kigali-Rwanda</p>\r\n                            <p class=\"footer\">SWIFT: <strong>GTBIRWRK</strong></p>\r\n                        </td>\r\n                    </tr>\r\n                </tbody>\r\n            </table>\r\n            <div class=\"signature\">\r\n                <p>Adv. CYAGA N.Eric</p>\r\n                <p>Managing Partner.</p>\r\n            </div>\r\n        </div>\r\n        <!-- Footer -->\r\n        <div style=\"margin-top: 20px; font-size: 12px; color: #1f272e; padding: 10px;\">\r\n            <hr style=\"border: none; border-top: 1px solid #1f272e; margin-top: 10px;\">\r\n            <div style=\"display: flex; justify-content: space-between; align-items: center;\">\r\n                <!-- Address Section -->\r\n                <div>\r\n                    8, KG 501 ST Kabare<br>\r\n                    Kamatamu, Kacyiru\r\n                </div>\r\n                <!-- Website and Contact Section -->\r\n                <div style=\"text-align: center;\">\r\n                    <a\r\n                        href=\"http://www.ksolutions-law.com\"\r\n                        style=\"color: #1f272e; text-decoration: none;\"\r\n                    >www.ksolutions-law.com</a> //\r\n                    <a\r\n                        href=\"mailto:info@ksolutions-law.com\"\r\n                        style=\"color: #1f272e; text-decoration: none;\"\r\n                    >info@ksolutions-law.com</a><br>\r\n                    Tel: (250) 078 830 0926 \u2013 (250) 078 830 0973\r\n                </div>\r\n                <!-- PO Box Section -->\r\n                <div style=\"text-align: right;\">\r\n                    B.P. 4062 Kigali<br>\r\n                    Rwandaa\r\n                </div>\r\n            </div>\r\n            <!-- Divider -->\r\n        </div>\r\n    </body>\r\n\r\n</html>",
